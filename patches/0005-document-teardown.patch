+    def close(self):
+        ''' Releases everything that keeps a removed document alive:
+            handlers on global objects, timers and threads. '''
+
+        owners = [self, self.view, self.presenter, self.controller, self.parser, self.code_folding, self.gutter, self.search]
+        for name in ['update_matching_blocks', 'bracket_completion', 'autocomplete', 'spellchecking', 'build_system', 'build_widget', 'preview']:
+            if hasattr(self, name): owners.append(getattr(self, name))
+        if hasattr(self, 'preview'):
+            for name in ['layouter', 'zoom_manager', 'presenter', 'controller', 'page_renderer', 'links_parser']:
+                if hasattr(self.preview, name): owners.append(getattr(self.preview, name))
+        self.settings.disconnect_owned_by(owners)
+
+        self.controller.continue_save_date_loop = False
+        if hasattr(self, 'spellchecking'): self.spellchecking.close()
+        if hasattr(self, 'build_system'): self.build_system.close()
+        if hasattr(self, 'preview'): self.preview.close()
+        if hasattr(self, 'build_widget'): self.build_widget.view.close()
+        self.release_gtk_objects()
+
+    def release_gtk_objects(self):
+        ''' PyGObject keeps Python wrappers of child widgets alive from the C
+            side, and draw functions, signal handlers and Python attributes
+            of widget subclasses point back to this document. That makes the
+            whole graph unreachable for the garbage collector, so it is taken
+            apart here (the widgets are already detached from the window). '''
+
+        main_window = ServiceLocator.get_main_window()
+        objects = list()
+
+        def add_widget_tree(widget):
+            objects.append(widget)
+            child = widget.get_first_child()
+            while child != None:
+                add_widget_tree(child)
+                child = child.get_next_sibling()
+
+        roots = [self.view]
+        if hasattr(self, 'preview'): roots.append(self.preview.view)
+        if hasattr(self, 'build_widget'): roots.append(self.build_widget.view)
+        for root in roots:
+            if root.get_root() == None: add_widget_tree(root)
+
+        for widget in list(objects):
+            controllers = widget.observe_controllers()
+            for i in range(controllers.get_n_items()):
+                objects.append(controllers.get_item(i))
+
+        for widget in list(objects):
+            if isinstance(widget, Gtk.Scrollbar):
+                objects.append(widget.get_adjustment())
+            elif isinstance(widget, Gtk.ScrolledWindow):
+                objects.append(widget.get_hadjustment())
+                objects.append(widget.get_vadjustment())
+            elif isinstance(widget, Gtk.Scrollable):
+                if widget.get_hadjustment() != None: objects.append(widget.get_hadjustment())
+                if widget.get_vadjustment() != None: objects.append(widget.get_vadjustment())
+
+        # other GObjects held in attributes: buffer, adjustments, actions, search context, ...
+        # (only objects owned by this document: never the main window, application, workspace, ...)
+        def is_owned_code(obj):
+            module = type(obj).__module__
+            return module.startswith('setzer.document') or module.startswith('setzer.widgets')
+
+        seen = set()
+        components = list()
+        stack = [self] + [widget for widget in objects if is_owned_code(widget)]
+        while stack:
+            obj = stack.pop()
+            if id(obj) in seen: continue
+            seen.add(id(obj))
+            if isinstance(obj, (Gtk.Window, Gio.Application)) or obj is main_window:
+                continue
+            if isinstance(obj, GObject.Object):
+                if type(obj).__module__.startswith('setzer') and not is_owned_code(obj):
+                    continue
+                if not isinstance(obj, Gtk.Widget) or obj.get_root() == None:
+                    objects.append(obj)
+                    if is_owned_code(obj): stack.extend(vars(obj).values())
+            elif isinstance(obj, dict): stack.extend(obj.values())
+            elif isinstance(obj, (list, tuple, set)): stack.extend(obj)
+            elif is_owned_code(obj):
+                components.append(obj)
+                stack.extend(vars(obj).values())
+
+        unique = dict()
+        for obj in objects: unique[id(obj)] = obj
+        for obj in unique.values():
+            if isinstance(obj, Gtk.Popover) and obj.get_parent() != None:
+                obj.popdown()
+                obj.unparent()
+        for obj in unique.values():
+            if isinstance(obj, Gtk.DrawingArea): obj.set_draw_func(None)
+            if type(obj).__module__.startswith('gi.repository.GtkSource'):
+                # these have handlers of their own (e.g. between search context and buffer),
+                # so only remove the handlers that call back into this document's objects
+                for component in components:
+                    for name in dir(type(component)):
+                        if name.startswith('__') or not callable(getattr(type(component), name, None)): continue
+                        try: obj.disconnect_by_func(getattr(component, name))
+                        except TypeError: pass
+            else:
+                GObject.signal_handlers_destroy(obj)
+            if is_owned_code(obj) and hasattr(obj, '__dict__'):
+                obj.__dict__.clear()
+
     def on_settings_changed(self, settings, parameter):
         section, item, value = parameter
 
