         else:
             self.connected_functions[change_code] = {callback}
 
+    def disconnect_owned_by(self, owners):
+        ''' Removes all callbacks that are bound methods of one of the
+            given objects, so that they can be garbage collected. '''
+
+        for change_code in list(self.connected_functions):
+            for callback in list(self.connected_functions[change_code]):
+                owner = getattr(callback, '__self__', None)
+                if owner is not None and any(owner is candidate for candidate in owners):
+                    self.connected_functions[change_code].discard(callback)
+            if len(self.connected_functions[change_code]) == 0:
+                del(self.connected_functions[change_code])
+
     def disconnect(self, change_code, callback):
         if change_code in self.connected_functions:
             self.connected_functions[change_code].discard(callback)
